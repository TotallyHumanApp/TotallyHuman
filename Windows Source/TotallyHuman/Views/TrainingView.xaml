<UserControl x:Class="TotallyHuman.Views.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:TotallyHuman.Utilities"
             Background="{StaticResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="960" HorizontalAlignment="Left">

            <!-- Kopf -->
            <TextBlock Style="{StaticResource H1}"
                       Text="{Binding [training.title], Source={x:Static util:LocProxy.Instance}}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                       Text="{Binding [training.subtitle], Source={x:Static util:LocProxy.Instance}}" />

            <!-- Statistik -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11"
                                   Text="{Binding [training.total], Source={x:Static util:LocProxy.Instance}}" />
                        <TextBlock Foreground="{StaticResource OrangeBrush}" FontSize="22" FontWeight="Bold"
                                   Text="{Binding TrainingSampleCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11"
                                   Text="{Binding [training.real], Source={x:Static util:LocProxy.Instance}}" />
                        <TextBlock Foreground="{StaticResource GreenBrush}" FontSize="22" FontWeight="Bold"
                                   Text="{Binding TrainingEchtCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11"
                                   Text="{Binding [training.ki], Source={x:Static util:LocProxy.Instance}}" />
                        <TextBlock Foreground="{StaticResource RedBrush}" FontSize="22" FontWeight="Bold"
                                   Text="{Binding TrainingKICount}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11"
                                   Text="{Binding [training.accuracy], Source={x:Static util:LocProxy.Instance}}" />
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold"
                                   Text="{Binding TrainingAccuracy, StringFormat={}{0:P1}}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Drop-Zonen -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="DropReal" Style="{StaticResource Card}" AllowDrop="True"
                        Margin="0,0,7,0" MinHeight="120" Cursor="Hand"
                        DragOver="Drop_DragOver" Drop="DropReal_Drop" MouseLeftButtonUp="DropReal_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="✅" FontSize="26" HorizontalAlignment="Center" />
                        <TextBlock Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold" Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   Text="{Binding [training.dropreal], Source={x:Static util:LocProxy.Instance}}" />
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                Click="AddReal_Click"
                                Content="{Binding [training.add.real], Source={x:Static util:LocProxy.Instance}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" x:Name="DropKi" Style="{StaticResource Card}" AllowDrop="True"
                        Margin="7,0,0,0" MinHeight="120" Cursor="Hand"
                        DragOver="Drop_DragOver" Drop="DropKi_Drop" MouseLeftButtonUp="DropKi_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="26" HorizontalAlignment="Center" />
                        <TextBlock Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   Text="{Binding [training.dropki], Source={x:Static util:LocProxy.Instance}}" />
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                Click="AddKi_Click"
                                Content="{Binding [training.add.ki], Source={x:Static util:LocProxy.Instance}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Aktionen -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Click="Train_Click"
                        Content="{Binding [training.start], Source={x:Static util:LocProxy.Instance}}" />
                <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Reseed_Click"
                        Content="{Binding [training.reseed], Source={x:Static util:LocProxy.Instance}}" />
                <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OpenFolder_Click"
                        Content="{Binding [training.openfolder], Source={x:Static util:LocProxy.Instance}}" />
                <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Clear_Click"
                        Content="{Binding [training.clear], Source={x:Static util:LocProxy.Instance}}" />
            </StackPanel>

            <!-- Statuszeile -->
            <Border Style="{StaticResource OrangeCard}" Margin="0,14,0,0" Padding="14,10">
                <TextBlock Text="{Binding TrainingStatusText}" TextWrapping="Wrap" />
            </Border>

            <!-- Proben-Tabelle -->
            <TextBlock Style="{StaticResource H2}" Margin="0,18,0,8"
                       Text="{Binding [training.samples], Source={x:Static util:LocProxy.Instance}}" />
            <Border Style="{StaticResource Card}" Padding="0" Height="280">
                <DataGrid ItemsSource="{Binding TrainingProbes}" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="2*" Binding="{Binding DateiName}"
                                            Header="{Binding [training.col.name], Source={x:Static util:LocProxy.Instance}}" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Label, Converter={StaticResource LabelToText}}"
                                            Header="{Binding [training.col.label], Source={x:Static util:LocProxy.Instance}}" />
                        <DataGridTextColumn Width="1.3*"
                                            Binding="{Binding HinzugefuegtAm, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                            Header="{Binding [training.col.added], Source={x:Static util:LocProxy.Instance}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
