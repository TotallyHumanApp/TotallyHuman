<UserControl x:Class="TotallyHuman.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:TotallyHuman.Utilities"
             Background="{StaticResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H1}"
                       Text="{Binding [settings.title], Source={x:Static util:LocProxy.Instance}}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                       Text="{Binding [settings.autosave], Source={x:Static util:LocProxy.Instance}}" />

            <!-- Sprache -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}"
                               Text="{Binding [settings.language], Source={x:Static util:LocProxy.Instance}}" />
                    <ComboBox x:Name="LangBox" Width="220" HorizontalAlignment="Left" Margin="0,10,0,0"
                              SelectionChanged="LangBox_SelectionChanged">
                        <ComboBoxItem Tag="de"
                                      Content="{Binding [settings.lang.de], Source={x:Static util:LocProxy.Instance}}" />
                        <ComboBoxItem Tag="en"
                                      Content="{Binding [settings.lang.en], Source={x:Static util:LocProxy.Instance}}" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Darstellung -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}"
                               Text="{Binding [settings.appearance], Source={x:Static util:LocProxy.Instance}}" />
                    <CheckBox Margin="0,10,0,0" IsChecked="{Binding IsOrangeThemeEnabled}"
                              Content="{Binding [settings.orangetheme], Source={x:Static util:LocProxy.Instance}}" />
                    <CheckBox IsChecked="{Binding IsPreviewEnabled}"
                              Content="{Binding [settings.preview], Source={x:Static util:LocProxy.Instance}}" />
                </StackPanel>
            </Border>

            <!-- Analyse -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}"
                               Text="{Binding [settings.analysis], Source={x:Static util:LocProxy.Instance}}" />

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding [settings.quality], Source={x:Static util:LocProxy.Instance}}" />
                        <TextBlock DockPanel.Dock="Right" Width="52" TextAlignment="Right"
                                   Foreground="{StaticResource OrangeBrush}" FontWeight="Bold"
                                   Text="{Binding QualityThreshold, StringFormat={}{0:F0}}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding QualityThreshold}" VerticalAlignment="Center" />
                    </DockPanel>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding [settings.segment], Source={x:Static util:LocProxy.Instance}}" />
                        <TextBlock DockPanel.Dock="Right" Width="52" TextAlignment="Right"
                                   Foreground="{StaticResource OrangeBrush}" FontWeight="Bold"
                                   Text="{Binding SegmentLengthSeconds, StringFormat={}{0:F0} s}" />
                        <Slider Minimum="3" Maximum="30" Value="{Binding SegmentLengthSeconds}" VerticalAlignment="Center" />
                    </DockPanel>

                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding RequireBatchConfirmation}"
                              Content="{Binding [settings.batchconfirm], Source={x:Static util:LocProxy.Instance}}" />
                    <CheckBox IsChecked="{Binding ShowDetailedHints}"
                              Content="{Binding [settings.detailedhints], Source={x:Static util:LocProxy.Instance}}" />
                </StackPanel>
            </Border>

            <!-- Speicher & Daten -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}"
                               Text="{Binding [settings.storage], Source={x:Static util:LocProxy.Instance}}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="11.5"
                               Text="{Binding SpeicherOrdner}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click"
                                Content="{Binding [settings.openfolder], Source={x:Static util:LocProxy.Instance}}" />
                        <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Reseed_Click"
                                Content="{Binding [settings.reseed], Source={x:Static util:LocProxy.Instance}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Über -->
            <Border Style="{StaticResource OrangeCard}" Margin="0,14,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}"
                               Text="{Binding [settings.about], Source={x:Static util:LocProxy.Instance}}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding [settings.about.text], Source={x:Static util:LocProxy.Instance}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
